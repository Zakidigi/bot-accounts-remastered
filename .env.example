# SQLite local (dev). Em produção, aponte para Postgres (Neon/Supabase free tier).
DATABASE_URL="file:./dev.db"
# Gere uma string aleatória longa para produção: openssl rand -hex 32
SESSION_SECRET="troque-isto-por-uma-string-aleatoria-longa"

# Teste da WhatsApp Cloud API (ver docs/agente-whatsapp-despesas.md)
WHATSAPP_VERIFY_TOKEN="teste123"
# Copia estes dois da página "Etapa 1. Experimente" no Meta for Developers.
# Nunca commites os valores reais — só ficam no teu .env local.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
